{
    "name": "md-math-formatter",
    "displayName": "Markdown Math Formatter",
    "description": "Format Equation in Markdown",
    "version": "0.0.1",
    "publisher": "ipota",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/IpotaZero/md-math-formatter.git"
    },
    "bugs": {
        "url": "https://github.com/IpotaZero/md-math-formatter/issues"
    },
    "categories": [
        "Formatters",
        "Other"
    ],
    "keywords": [
        "markdown",
        "math",
        "latex",
        "formatter"
    ],
    "engines": {
        "vscode": "^1.75.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:markdown"
    ],
    "scripts": {
        "package": "vsce package",
        "build:install": "node scripts/build-and-install.js",
        "test": "node --test test/*.test.js"
    },
    "contributes": {
        "commands": [
            {
                "command": "extension.formatMath",
                "title": "Markdown: Equation Formatter"
            }
        ],
        "keybindings": [
            {
                "command": "extension.formatMath",
                "key": "alt+f",
                "mac": "option+f",
                "when": "editorTextFocus && editorLangId == markdown"
            }
        ],
        "configuration": {
            "title": "Markdown Math Formatter",
            "properties": {
                "mdMathFormatter.formatOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Format on save"
                }
            }
        }
    }
}
